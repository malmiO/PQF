.env.local
.env.*.local
*.key
secrets.py
config_local.py

# ── Dataset images ────────────────────────────────────────────────────────────
# Raw product images are large binary files — store on Google Drive / OneDrive
# Do NOT commit 200 product images to git
dataset/food/
dataset/fashion/
dataset/*.jpg
dataset/*.jpeg
dataset/*.png

# Keep the dataset folder structure (empty folders)
!dataset/.gitkeep
!dataset/food/.gitkeep
!dataset/fashion/.gitkeep

# ── Generated / output files ──────────────────────────────────────────────────
tqs_results.csv
tqs_results_mini.csv
expert_ratings.csv
expert_ratings_mini.csv
expert_ratings_converted.csv
full_results.json
form_responses/
*.log

# ── Test images (generated by make_test_images.py — not needed in repo) ───────
backend/pqf_engine/good.jpg
backend/pqf_engine/blurry.jpg
backend/pqf_engine/dark.jpg
backend/pqf_engine/busy_bg.jpg
backend/pqf_engine/pqf_dataset_mini/

# ── pyiqa model cache ─────────────────────────────────────────────────────────
# Downloaded automatically on first run — large files, not needed in repo
.cache/
*.pth
*.mat
*.npz

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── IDE / Editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Mac ───────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Flutter / Dart ────────────────────────────────────────────────────────────
mobile_app/.dart_tool/
mobile_app/.flutter-plugins
mobile_app/.flutter-plugins-dependencies
mobile_app/.packages
mobile_app/build/
mobile_app/android/.gradle/
mobile_app/android/local.properties
mobile_app/android/key.properties
mobile_app/ios/.symlinks/
mobile_app/ios/Pods/
mobile_app/ios/Flutter/Flutter.framework
mobile_app/ios/Flutter/Flutter.podspec
mobile_app/*.g.dart
mobile_app/pubspec.lock

# Keep pubspec.yaml and pubspec.lock for reproducibility
!mobile_app/pubspec.yaml
!mobile_app/pubspec.lock

# ── Evaluation output (raw data files — share via Drive not git) ───────────────
evaluation/*.csv
evaluation/*.json
evaluation/*.png
evaluation/*.pdf

# Keep the evaluation folder
!evaluation/.gitkeep