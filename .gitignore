# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual environment ───────────────────────────────────────────────────────
backend/venv/
.venv/
env/
ENV/
.env

# ── Environment / secrets ─────────────────────────────────────────────────────
